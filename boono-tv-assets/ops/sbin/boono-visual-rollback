#!/usr/bin/env python3
"""Select or roll back the active BOONO visual release via the Git control file."""
from pathlib import Path
import datetime, json, os, subprocess, sys

REPO=Path("/srv/boono-tv-assets-repo")
BRANCH="boono-tv-assets"

def run(args,capture=False):
    return subprocess.run(args,cwd=REPO,check=True,text=True,
                          stdout=subprocess.PIPE if capture else None,
                          stderr=subprocess.STDOUT if capture else None)

if len(sys.argv) not in (2,3) or sys.argv[1] not in ("assets","scenes"):
    raise SystemExit("Usage: boono-visual-rollback assets|scenes [previous|RELEASE]")

kind=sys.argv[1]
root=Path("/srv/boono-tv-assets" if kind=="assets" else "/srv/boono-tv-scenes")
control=REPO/"boono-tv-assets"/"control"/("current.json" if kind=="assets" else "scenes-current.json")
sync="/usr/local/sbin/boono-assets-sync" if kind=="assets" else "/usr/local/sbin/boono-scenes-sync"
release_dir=REPO/"boono-tv-assets"/("releases" if kind=="assets" else "scene-releases")

run(["git","fetch","--quiet","origin",BRANCH])
run(["git","checkout","-q",BRANCH])
run(["git","reset","--hard",f"origin/{BRANCH}"])
dirty=run(["git","status","--porcelain"],capture=True).stdout.strip()
if dirty: raise SystemExit(f"asset worktree dirty; aborting rollback:\n{dirty}")

cfg=json.loads(control.read_text())
current=cfg.get("release")
requested=sys.argv[2] if len(sys.argv)==3 else "previous"
if requested=="previous":
    prev=root/"previous"
    if not (prev.exists() or prev.is_symlink()):
        raise SystemExit("no previous release recorded")
    target=Path(os.path.realpath(prev)).name
else:
    target=requested
if target==current:
    raise SystemExit(f"{target} is already active")
if not (release_dir/target/"manifest.json").is_file():
    raise SystemExit(f"target release not found in Git worktree: {target}")

cfg.update({
    "release":target,
    "status":"active",
    "rollback_from":current,
    "updated_at":datetime.datetime.now(datetime.timezone.utc).isoformat(),
})
control.write_text(json.dumps(cfg,indent=2)+"\n")
rel=control.relative_to(REPO).as_posix()
run(["git","add",rel])
staged=run(["git","diff","--cached","--name-only"],capture=True).stdout.splitlines()
if staged != [rel]:
    run(["git","reset","--hard",f"origin/{BRANCH}"])
    raise SystemExit(f"unexpected rollback scope: {staged}")
try:
    run(["git","commit","-m",f"Rollback BOONO {kind} {current} -> {target}"])
    run(["git","push","origin",BRANCH])
except Exception:
    run(["git","reset","--hard",f"origin/{BRANCH}"])
    raise
subprocess.run([sync],check=True)
print(f"BOONO {kind} active release: {target} (from {current})")
