#!/usr/bin/env python3
"""
Import one validated BOONO-TV layered runtime bundle.
The importer writes nothing to runtime until the full release is built, validated,
committed, LFS-checked, pushed, re-fetched and re-validated by boono-assets-sync.
"""
from __future__ import annotations
from pathlib import Path, PurePosixPath
from PIL import Image
from io import BytesIO
import datetime, fcntl, hashlib, json, os, shutil, subprocess, sys, tempfile, zipfile

BRANCH="boono-tv-assets"
REPO=Path("/srv/boono-tv-assets-repo")
BUILD_ROOT=Path("/srv/boono-tv-assets/build")
SYNC="/usr/local/sbin/boono-assets-sync"
STATES=["working","thinking","worried","concentrated","confident","observe","execute"]

EXPECTED={
    "boono_room_backplate_1200x1080.webp":"room_backplate.webp",
    "boono_desk_foreground_1200x1080.webp":"desk_foreground.webp",
    **{f"boono_{s}_1200x1080.webp":f"boono/{s}.webp" for s in STATES},
}

def run(argv, *, cwd=None, capture=False):
    return subprocess.run(argv,cwd=cwd,check=True,text=True,
                          stdout=subprocess.PIPE if capture else None,
                          stderr=subprocess.STDOUT if capture else None)

def sha256_bytes(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()

def sha256_path(p: Path) -> str:
    h=hashlib.sha256()
    with p.open("rb") as f:
        for b in iter(lambda:f.read(4*1024*1024),b""): h.update(b)
    return h.hexdigest()

def assert_repo_clean():
    out=run(["git","status","--porcelain"],cwd=REPO,capture=True).stdout.strip()
    if out:
        raise RuntimeError(f"asset worktree not clean before transaction:\n{out}")

def reset_repo():
    subprocess.run(["git","reset","--hard",f"origin/{BRANCH}"],cwd=REPO,
                   stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
    subprocess.run(["git","clean","-fd"],cwd=REPO,
                   stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)

def main():
    if len(sys.argv)!=2:
        raise SystemExit("Usage: boono-assets-import BUNDLE.zip")
    src=Path(sys.argv[1]).resolve()
    if not src.is_file() or src.is_symlink() or src.suffix.lower()!=".zip":
        raise SystemExit(f"invalid bundle: {src}")

    lock_path=Path("/run/lock/boono-assets-import.lock")
    lock_path.parent.mkdir(parents=True,exist_ok=True)
    lock=open(lock_path,"w")
    fcntl.flock(lock,fcntl.LOCK_EX)

    source_sha=sha256_path(src)
    stamp=datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    release=f"boono-tv-{stamp}-{source_sha[:8]}"
    BUILD_ROOT.mkdir(parents=True,exist_ok=True)
    stage=Path(tempfile.mkdtemp(prefix=f".{release}.",dir=BUILD_ROOT))
    pushed=False

    try:
        # Exact basename contract: each expected asset must exist exactly once.
        with zipfile.ZipFile(src,"r") as z:
            by_base={}
            for zi in z.infolist():
                if zi.is_dir(): continue
                q=PurePosixPath(zi.filename)
                if q.is_absolute() or ".." in q.parts:
                    raise RuntimeError(f"unsafe archive path: {zi.filename}")
                by_base.setdefault(q.name,[]).append(zi)
            for wanted in EXPECTED:
                matches=by_base.get(wanted,[])
                if len(matches)!=1:
                    raise RuntimeError(f"{wanted}: expected exactly once, found {len(matches)}")

            files={}
            for source_name,dest_rel in EXPECTED.items():
                raw=z.read(by_base[source_name][0])
                p=stage/dest_rel
                p.parent.mkdir(parents=True,exist_ok=True)
                p.write_bytes(raw)
                im=Image.open(BytesIO(raw)); im.load()
                if im.format!="WEBP" or im.size!=(1200,1080):
                    raise RuntimeError(f"invalid {source_name}: {im.format} {im.size}")
                if dest_rel!="room_backplate.webp":
                    if "A" not in im.mode:
                        raise RuntimeError(f"alpha missing: {source_name}")
                    lo,hi=im.getchannel("A").getextrema()
                    if lo==255:
                        raise RuntimeError(f"transparent layer has no transparent pixels: {source_name}")
                files[dest_rel]={
                    "sha256":sha256_bytes(raw),"bytes":len(raw),
                    "width":im.width,"height":im.height,"mode":im.mode,"format":im.format,
                    "alpha_required":dest_rel!="room_backplate.webp",
                }

        manifest={
            "schema":2,
            "kind":"boono-tv-layered-runtime",
            "release":release,
            "created_at":datetime.datetime.now(datetime.timezone.utc).isoformat(),
            "source":{"name":src.name,"sha256":source_sha,"published":False},
            "canvas":{"width":1200,"height":1080},
            "states":STATES,
            "files":files,
        }
        (stage/"manifest.json").write_text(json.dumps(manifest,indent=2,ensure_ascii=False)+"\n")

        # Re-open every produced file from disk: validation is on deployable bytes.
        expected_rel={"room_backplate.webp","desk_foreground.webp",
                      *{f"boono/{s}.webp" for s in STATES},"manifest.json"}
        actual={p.relative_to(stage).as_posix() for p in stage.rglob("*") if p.is_file()}
        if actual!=expected_rel:
            raise RuntimeError(f"release file set mismatch: {sorted(actual ^ expected_rel)}")

        run(["git","fetch","--quiet","origin",BRANCH],cwd=REPO)
        run(["git","checkout","-q",BRANCH],cwd=REPO)
        run(["git","reset","--hard",f"origin/{BRANCH}"],cwd=REPO)
        assert_repo_clean()

        repo_rel=REPO/"boono-tv-assets"/"releases"/release
        if repo_rel.exists():
            raise RuntimeError(f"release already exists: {release}")
        shutil.copytree(stage,repo_rel)

        control=REPO/"boono-tv-assets"/"control"/"current.json"
        control.parent.mkdir(parents=True,exist_ok=True)
        control.write_text(json.dumps({
            "schema":2,"kind":"boono-tv-layered-runtime",
            "release":release,"status":"active",
            "updated_at":datetime.datetime.now(datetime.timezone.utc).isoformat(),
        },indent=2)+"\n")

        relpath=repo_rel.relative_to(REPO).as_posix()
        ctlpath=control.relative_to(REPO).as_posix()
        run(["git","add",relpath,ctlpath],cwd=REPO)
        staged=set(run(["git","diff","--cached","--name-only"],cwd=REPO,capture=True).stdout.splitlines())
        expected_git={ctlpath,*{p.relative_to(REPO).as_posix() for p in repo_rel.rglob("*") if p.is_file()}}
        if staged!=expected_git:
            raise RuntimeError(f"unexpected staged scope: {sorted(staged ^ expected_git)}")

        run(["git","commit","-m",f"Publish BOONO-TV layered release {release}"],cwd=REPO)
        run(["git","lfs","fsck"],cwd=REPO)
        run(["git","push","origin",BRANCH],cwd=REPO)
        pushed=True

        run([SYNC])
        print(f"Layered BOONO-TV release imported and activated: {release}")
        print(f"source_sha256={source_sha}")
    except Exception:
        if not pushed:
            try:
                run(["git","fetch","--quiet","origin",BRANCH],cwd=REPO)
                reset_repo()
            except Exception:
                pass
        raise
    finally:
        shutil.rmtree(stage,ignore_errors=True)

if __name__=="__main__":
    main()
