--- a/private-preview-access.js
+++ b/private-preview-access.js
@@ -0,0 +1,17 @@
+'use strict';
+// BOONO-TV private preview, OD-20261118-007.
+// The studio itself listens ONLY on 127.0.0.1:3091 (OVH). Calls from
+// ChromeOS use an SSH forwarded Crostini private address and retain their
+// original Host header. Accept that precise private tunnel form, NOT
+// arbitrary/private Internet hosts or public domain names.
+const LOOPBACK=new Set(['127.0.0.1','::1','::ffff:127.0.0.1']);
+const LOCAL_HOST=new Set(['127.0.0.1','localhost']);
+module.exports=function privatePreviewAccess(req){
+ const remote=req.socket?.remoteAddress||'';
+ if(!LOOPBACK.has(remote))return false;
+ const hostname=req.hostname||'';
+ if(LOCAL_HOST.has(hostname))return true;
+ const host=req.get?.('host')||'';
+ const match=/^100\.115\.92\.(\d{1,3}):8310$/.exec(host);
+ return !!match&&Number(match[1])<=255&&hostname===`100.115.92.${match[1]}`;
+};
